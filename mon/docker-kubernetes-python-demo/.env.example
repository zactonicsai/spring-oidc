# cp .env.example .env   (.env is git-ignored; sourced by scripts/lib/common.sh AFTER build/config.env,
# so anything here overrides the values derived from app.config.yaml)
# AZ_SUBSCRIPTION=My Subscription Name       # az account set --subscription
# AZ_LOCATION=westus2                        # override targets.azure.location
# AZ_ACR_NAME_OVERRIDE=mycompanydemoacr      # ACR names are global: letters+digits, 5-50 chars
# AZ_KEYVAULT_NAME_OVERRIDE=kv-mycompany-demo
# CLUSTER_NAME=python-demo                   # kind cluster name
