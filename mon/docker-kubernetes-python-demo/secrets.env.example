# cp secrets.env.example secrets.env   (secrets.env is git-ignored; chmod 600 secrets.env)
# One KEY=value per line for every key listed under services[].secrets in app.config.yaml.
# Local:  tools/appconfig.py render secrets  turns this into build/secrets-values.yaml for Helm.
# Azure:  scripts/azure/08-secrets.sh pulls the values from Key Vault instead.
API_TOKEN=change-me-local-token
