# cp terraform.tfvars.example terraform.tfvars   (terraform.tfvars is git-ignored)
# subscription_id      = "00000000-0000-0000-0000-000000000000"   # or export ARM_SUBSCRIPTION_ID
# location             = "eastus"                                  # default: targets.azure.location
ssh_public_key_path  = "~/.ssh/id_rsa.pub"
ssh_private_key_path = "~/.ssh/id_rsa"
build_images         = true      # runs `az acr build` (needs az login)
deploy_helm          = true
run_ansible          = false
# create_vm          = false     # override targets.azure.vm.enabled
# public_service_source_ranges = ["203.0.113.4/32"]   # lock the public LB to your IP
# secrets: NEVER put real values in a committed file. Use:
#   export TF_VAR_secrets='{"API_TOKEN":"change-me"}'
