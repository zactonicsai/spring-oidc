#!/usr/bin/env bash
# Generated by podgen — deploys "{{ name }}" to namespace "{{ namespace }}" on {{ provider_title }} with kubectl.
# Regenerate with: python -m podgen generate {{ source_file }} --provider {{ provider }} --force
#
# Steps: namespace -> secrets from {{ secret_store }} -> ServiceAccount (+ cloud identity)
#        -> {% if configure.phase == 'pre' and configure.method != 'none' %}pre-deploy configuration -> {% endif %}workload -> rollout{% if configure.phase == 'post' and configure.method != 'none' %} -> post-deploy configuration{% endif %}

set -Eeuo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PODKIT_ROOT="${PODKIT_ROOT:-$(cd "$HERE/{{ root_rel }}" && pwd)}"
# shellcheck source=/dev/null
source "$PODKIT_ROOT/scripts/lib/common.sh"
# shellcheck source=/dev/null
source "$PODKIT_ROOT/scripts/lib/cloud.sh"
load_env_file "$HERE/pod.env"
export BUILD_DIR="$HERE"

require_cmd kubectl{% if cloud_secrets %} {{ cli }}{% endif %}

log "Deploying $NAME to namespace $NAMESPACE on {{ provider_title }} (context: $(current_context))"
kube get namespace "$NAMESPACE" >/dev/null 2>&1 || kube create namespace "$NAMESPACE"

{% if cloud_secrets %}
# --- Secrets: read from {{ secret_store }} at deploy time; never written to disk ---------
log "Syncing {{ cloud_secrets | length }} secret(s) from {{ secret_store }} into Secret $NAME-env"
secret_args=()
{% for env_name, ref in cloud_secrets.items() %}
secret_args+=("--from-literal={{ env_name }}=$(cloud_secret_get "$PROVIDER" {{ ref | sq }})")
{% endfor %}
kube -n "$NAMESPACE" create secret generic "$NAME-env" "${secret_args[@]}" --dry-run=client -o yaml \
  | kube apply --server-side --field-manager=podkit -f - >/dev/null
unset secret_args
SECRET_CHECKSUM="$(kube -n "$NAMESPACE" get secret "$NAME-env" -o jsonpath='{.data}' | sha256sum | cut -c1-16)"
{% else %}
SECRET_CHECKSUM="none"
{% endif %}

# --- ServiceAccount first, so the cloud identity is bound before any pod starts ---------
kube apply --server-side --field-manager=podkit -f "$HERE/k8s/serviceaccount.yaml"
{% if identity.enabled %}
if [[ -n "${IDENTITY_ID:-}" ]]; then
  kube -n "$NAMESPACE" annotate serviceaccount "$NAME" --overwrite "{{ identity.annotation_key }}=$IDENTITY_ID"
else
  warn "IDENTITY_ID is empty: $NAME is not bound to a cloud identity. Run terraform apply and set IDENTITY_ID in pod.env."
fi
{% endif %}

{% if configure.method != 'none' and configure.phase == 'pre' %}
# --- Pre-deploy configuration ({{ configure.method }}: {{ configure.target }}) from the command pod ---
"$HERE/configure.sh"

{% endif %}
log "Applying workload manifests"
render_template "$HERE/k8s/workload.yaml" "SECRET_CHECKSUM=$SECRET_CHECKSUM" \
  | kube apply --server-side --field-manager=podkit --force-conflicts -f -

log "Waiting for rollout"
kube -n "$NAMESPACE" rollout status deployment/"$NAME" --timeout="${ROLLOUT_TIMEOUT:-300s}"
{% if configure.method != 'none' and configure.phase == 'post' %}

# --- Post-deploy configuration ({{ configure.method }}: {{ configure.target }}) from the command pod ---
"$HERE/configure.sh"
{% endif %}

log "Deployed $NAME.{% if service_dns %} In-cluster address: {{ service_dns }}{% endif %}"
