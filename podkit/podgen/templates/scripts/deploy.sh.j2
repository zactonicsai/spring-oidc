#!/usr/bin/env bash
# Generated by podgen — deploys "{{ name }}" to namespace "{{ namespace }}" on {{ provider_title }}.
# Thin wrapper around `podkit pod deploy`; the logic lives in scripts/resources/*.sh (one plugin per resource).
#
{% set pre = ("-> pre-deploy " ~ configure.method ~ " step ") if (configure.phase == 'pre' and configure.method != 'none') else "" %}
{% set post = (" -> post-deploy " ~ configure.method ~ " step") if (configure.phase == 'post' and configure.method != 'none') else "" %}
#   ./deploy.sh                 kubectl path: namespace -> secrets from {{ secret_store }} -> ServiceAccount (+ identity)
#                               {{ pre }}-> workload -> rollout{{ post }}
#   ./deploy.sh -m terraform    Terraform path (creates the cloud identity too)
#   ./deploy.sh --dry-run       print every command instead of running it
# Regenerate with: python -m podgen generate {{ source_file }} --provider {{ provider }} --force
set -Eeuo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PODKIT_ROOT="${PODKIT_ROOT:-$(cd "$HERE/{{ root_rel }}" && pwd)}"
exec "$PODKIT_ROOT/bin/podkit" pod deploy "$HERE" "$@"
