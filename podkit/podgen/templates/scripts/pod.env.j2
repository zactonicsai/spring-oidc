# Generated by podgen from {{ source_file }} — the build's settings, read by every `podkit` resource plugin.
NAME={{ name }}
NAMESPACE={{ namespace }}
PROVIDER={{ provider }}
CLUSTER_NAME={{ cloud.clusterName | sq }}
{% if provider == "aws" %}
AWS_REGION={{ cloud.region | sq }}
{% elif provider == "azure" %}
AZURE_RESOURCE_GROUP={{ cloud.resourceGroup | sq }}
AZURE_KEY_VAULT={{ (cloud.keyVaultName | default("", true)) | sq }}
{% elif provider == "gcp" %}
GCP_PROJECT={{ cloud.project | sq }}
GCP_LOCATION={{ cloud.location | sq }}
{% endif %}
SERVICE_DNS={{ (service_dns or '') | sq }}
# Secrets read from {{ secret_store }} at deploy time (ENV=ref, comma separated) into Secret $ENV_SECRET.
ENV_SECRET={{ name }}-env
CLOUD_SECRETS={{ cloud_secrets_csv | sq }}
IDENTITY_ENABLED={{ 'true' if identity.enabled else 'false' }}
IDENTITY_ANNOTATION={{ identity.annotation_key }}
# {{ identity.annotation_key }} value: IAM role ARN / managed identity client id / GSA email.
# Set by `podkit identity apply` or `podkit pod deploy -m terraform`; required for the pod to reach cloud APIs.
IDENTITY_ID=${IDENTITY_ID:-}
TLS_ENABLED={{ 'true' if tls else 'false' }}
{% if tls %}
TLS_KEYSTORE_SECRET={{ tls.keystore_secret }}
TLS_CA_SECRET={{ tls.ca_secret }}
TLS_TRUSTSTORE_SECRET={{ tls.truststore_secret }}
{% endif %}
CONFIGURE_METHOD={{ configure.method }}
CONFIGURE_PHASE={{ configure.phase }}
CONFIGURE_TARGET={{ (configure.target or '') | sq }}
COMMAND_POD_NS=${COMMAND_POD_NS:-{{ command_pod_namespace }}}
TARGET_NAMESPACES=${TARGET_NAMESPACES:-{{ namespace }}}
