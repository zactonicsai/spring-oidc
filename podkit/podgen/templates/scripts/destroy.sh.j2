#!/usr/bin/env bash
# Generated by podgen — removes "{{ name }}" from namespace "{{ namespace }}" on {{ provider_title }}.
# Thin wrapper around `podkit pod destroy`.
#
#   ./destroy.sh [-y]                      workload, ServiceAccount and the env Secret
#   ./destroy.sh -m terraform              Terraform path (workload + cloud identity)
#   ./destroy.sh --purge-tls               also this pod's keystore Secret (shared CA/truststore are kept)
#   ./destroy.sh --delete-namespace        also the namespace
#   podkit destroy "$HERE" --everything    workload + TLS + identity + namespace in one go
set -Eeuo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PODKIT_ROOT="${PODKIT_ROOT:-$(cd "$HERE/{{ root_rel }}" && pwd)}"
exec "$PODKIT_ROOT/bin/podkit" pod destroy "$HERE" "$@"
