#!/usr/bin/env bash
# Generated by podgen — removes "{{ name }}" from namespace "{{ namespace }}" on {{ provider_title }}.
#   PODKIT_YES=1          skip the confirmation prompt
#   PURGE_TLS_SECRETS=1   also delete this pod's keystore Secret (the shared CA/truststore are kept)
#   DELETE_NAMESPACE=1    delete the namespace afterwards
set -Eeuo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PODKIT_ROOT="${PODKIT_ROOT:-$(cd "$HERE/{{ root_rel }}" && pwd)}"
# shellcheck source=/dev/null
source "$PODKIT_ROOT/scripts/lib/common.sh"
load_env_file "$HERE/pod.env"

require_cmd kubectl
confirm "Delete $NAME from namespace $NAMESPACE on {{ provider_title }} (context: $(current_context))?" || exit 0

render_template "$HERE/k8s/workload.yaml" "SECRET_CHECKSUM=none" \
  | kube delete --ignore-not-found --wait=true -f -
kube delete --ignore-not-found -f "$HERE/k8s/serviceaccount.yaml"
{% if cloud_secrets %}
kube -n "$NAMESPACE" delete secret "$NAME-env" --ignore-not-found
{% endif %}
{% if tls %}
if [[ "${PURGE_TLS_SECRETS:-0}" == "1" ]]; then
  kube -n "$NAMESPACE" delete secret {{ tls.keystore_secret }} --ignore-not-found
fi
{% endif %}
if [[ "${DELETE_NAMESPACE:-0}" == "1" ]]; then
  kube delete namespace "$NAMESPACE" --ignore-not-found
fi
log "Destroyed $NAME"
