#!/usr/bin/env bash
# Generated by podgen — runs the {{ configure.phase }}-deploy configuration for "{{ name }}".
{% if configure.method == 'none' %}
echo "No configuration step is defined for {{ name }} (spec.configure.method = none)."
{% else %}
#   method : {{ configure.method }}  ->  {{ configure.target }}
#   runs   : inside the command pod by default; CONFIGURE_VIA=local runs it from this machine.
set -Eeuo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PODKIT_ROOT="${PODKIT_ROOT:-$(cd "$HERE/{{ root_rel }}" && pwd)}"
# shellcheck source=/dev/null
source "$PODKIT_ROOT/scripts/lib/common.sh"
load_env_file "$HERE/pod.env"

{% if configure.method == 'ansible' %}
exec "$PODKIT_ROOT/scripts/configure.sh" --method ansible --playbook {{ configure.target | sq }} \
  --vars "$HERE/ansible/vars.yml" --build-dir "$HERE" "$@"
{% else %}
exec "$PODKIT_ROOT/scripts/configure.sh" --method shell --script {{ configure.target | sq }} \
  --env "$HERE/configure.env" --build-dir "$HERE" "$@"
{% endif %}
{% endif %}
