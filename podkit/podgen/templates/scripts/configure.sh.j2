#!/usr/bin/env bash
# Generated by podgen — runs the {{ configure.phase }}-deploy configuration step for "{{ name }}".
{% if configure.method == 'none' %}
# No configuration step is defined (spec.configure.method = none); `podkit configure run` reports the same.
{% else %}
#   method : {{ configure.method }}  ->  {{ configure.target }}
#   runs   : inside the command pod by default; --via local runs it from this machine.
#   extra  : arguments are passed through, e.g. ./configure.sh {% if configure.method == 'ansible' %}-e rotate=true{% else %}ROTATE=true{% endif %}
{% endif %}
set -Eeuo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PODKIT_ROOT="${PODKIT_ROOT:-$(cd "$HERE/{{ root_rel }}" && pwd)}"
exec "$PODKIT_ROOT/bin/podkit" configure run "$HERE" "$@"
