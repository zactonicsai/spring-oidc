# Generated by podgen from {{ source_file }} — regenerate instead of editing.
# Workload "{{ name }}" in namespace "{{ namespace }}" on {{ provider_title }}.
#
# module.cloud  : reads the existing cluster, resolves secrets from {{ secret_store }},
#                 optionally creates the pod's cloud identity and returns spot scheduling hints.
# module.pod    : the Deployment, Service, ServiceAccount, ConfigMap, NetworkPolicy and HPA.

module "cloud" {
  source = "{{ modules_source }}/{{ provider }}"

  cluster_name = var.cluster_name
{% if provider == "aws" %}
  region            = var.aws_region
  identity_mode     = {{ identity.mode | hcl }}
  extra_policy_arns = {{ identity.aws.policyArns | hcl(2) }}
{% elif provider == "azure" %}
  resource_group_name           = var.azure_resource_group
  key_vault_name                = var.azure_key_vault_name
  key_vault_resource_group_name = var.azure_key_vault_resource_group
  extra_role_assignments        = {{ identity.azure.roleAssignments | hcl(2) }}
{% elif provider == "gcp" %}
  project     = var.gcp_project
  location    = var.gcp_location
  extra_roles = {{ identity.gcp.roles | hcl(2) }}
{% endif %}

  name                 = var.name
  namespace            = var.namespace
  service_account_name = var.name
  create_identity      = {{ identity.enabled | hcl }}
  spot                 = {{ spot | hcl }}
  secrets              = var.cloud_secrets
}

module "pod" {
  source = "{{ modules_source }}/pod"

  name             = var.name
  namespace        = var.namespace
  create_namespace = var.create_namespace
  labels           = {{ labels | hcl(2) }}
  annotations      = {{ annotations | hcl(2) }}

  image             = "{{ image_repository }}:${var.image_tag}"
  image_pull_policy = {{ image_pull_policy | hcl }}
  command           = {{ command | hcl(2) }}
  args              = {{ args | hcl(2) }}
  replicas          = var.replicas
  ports             = {{ ports_tf | hcl(2) }}

  env              = {{ env | hcl(2) }}
  env_from_secrets = {{ k8s_secret_env | hcl(2) }}
  secret_env       = module.cloud.secret_values
  files            = {{ files | hcl(2) }}
  mounts           = {{ mounts_tf | hcl(2) }}

  resources     = {{ resources | hcl(2) }}
  node_selector = merge(module.cloud.node_selector, {{ node_selector_user | hcl(2) }})
  tolerations   = concat(module.cloud.tolerations, {{ tolerations_user | hcl(2) }})

  service_account_annotations = module.cloud.service_account_annotations
  pod_labels                  = module.cloud.pod_labels

  service        = {{ service | hcl(2) }}
  probe          = {{ probe_tf | hcl(2) }}
  network_policy = {{ network_policy | hcl(2) }}
  autoscaling    = {{ autoscaling | hcl(2) }}
  security       = {{ security | hcl(2) }}
}
