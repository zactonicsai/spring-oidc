# Generated by podgen — provider configuration for {{ provider_title }}.
# The kubernetes provider is pointed at the EXISTING cluster through module.cloud.
{% if provider == "aws" %}
provider "aws" {
  region = var.aws_region
}

provider "kubernetes" {
  host                   = module.cloud.cluster.host
  cluster_ca_certificate = module.cloud.cluster.ca_certificate

  # exec auth refreshes the short-lived EKS token on every run (a static token expires after ~15 minutes).
  exec {
    api_version = "client.authentication.k8s.io/v1beta1"
    command     = "aws"
    args        = ["eks", "get-token", "--cluster-name", var.cluster_name, "--region", var.aws_region]
  }
}
{% elif provider == "azure" %}
provider "azurerm" {
  features {}
  subscription_id = var.azure_subscription_id
}

# Uses the cluster admin kubeconfig exposed by the AKS data source (requires local accounts).
# For Entra-ID-only clusters replace the certificate arguments with:
#   exec { api_version = "client.authentication.k8s.io/v1beta1", command = "kubelogin",
#          args = ["get-token", "--login", "azurecli", "--server-id", "6dae42f8-4368-4678-94ff-3960e28e3630"] }
provider "kubernetes" {
  host                   = module.cloud.cluster.host
  cluster_ca_certificate = module.cloud.cluster.ca_certificate
  client_certificate     = module.cloud.cluster.client_certificate
  client_key             = module.cloud.cluster.client_key
}
{% elif provider == "gcp" %}
provider "google" {
  project = var.gcp_project
}

provider "kubernetes" {
  host                   = module.cloud.cluster.host
  cluster_ca_certificate = module.cloud.cluster.ca_certificate
  token                  = module.cloud.cluster.token
}
{% endif %}
