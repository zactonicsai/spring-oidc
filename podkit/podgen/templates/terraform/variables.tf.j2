# Generated by podgen — only the values that change between environments are variables;
# everything else is derived from {{ source_file }} and lives in main.tf.
variable "cluster_name" {
  description = "Name of the existing cluster."
  type        = string
}
{% if provider == "aws" %}

variable "aws_region" {
  type = string
}
{% elif provider == "azure" %}

variable "azure_resource_group" {
  description = "Resource group of the AKS cluster."
  type        = string
}

variable "azure_subscription_id" {
  description = "Subscription id (or set ARM_SUBSCRIPTION_ID)."
  type        = string
  default     = null
}

variable "azure_key_vault_name" {
  description = "Key Vault holding the secrets referenced in cloud_secrets."
  type        = string
  default     = null
}

variable "azure_key_vault_resource_group" {
  description = "Resource group of the Key Vault (defaults to azure_resource_group)."
  type        = string
  default     = null
}
{% elif provider == "gcp" %}

variable "gcp_project" {
  type = string
}

variable "gcp_location" {
  description = "Region or zone of the GKE cluster."
  type        = string
}
{% endif %}

variable "name" {
  type    = string
  default = {{ name | hcl }}
}

variable "namespace" {
  type    = string
  default = {{ namespace | hcl }}
}

variable "create_namespace" {
  description = "Create the namespace if it does not exist."
  type        = bool
  default     = true
}

variable "image_tag" {
  type    = string
  default = {{ image_tag | hcl }}
}

variable "replicas" {
  type    = number
  default = {{ replicas }}
}

variable "cloud_secrets" {
  description = "ENV_VAR => secret reference in {{ secret_store }}. Values are read at apply time and stored in Secret {{ name }}-env (they also land in the Terraform state: use an encrypted remote backend)."
  type        = map(string)
  default     = {{ cloud_secrets | hcl(2) }}
}
