aws_region   = {{ cloud.region | hcl }}
{% elif provider == "azure" %}
azure_resource_group           = {{ cloud.resourceGroup | hcl }}
azure_subscription_id          = {{ cloud.subscriptionId | default(None) | hcl }}
azure_key_vault_name           = {{ cloud.keyVaultName | default(None) | hcl }}
azure_key_vault_resource_group = {{ cloud.keyVaultResourceGroup | default(None) | hcl }}
{% elif provider == "gcp" %}
gcp_project  = {{ cloud.project | hcl }}
gcp_location = {{ cloud.location | hcl }}
{% endif %}
