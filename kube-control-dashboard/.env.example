# Local-only by default. Keep this on loopback unless you add real authentication/TLS.
HOST=127.0.0.1
PORT=8787

# Read operations are always available when kubectl access allows them.
# Set to true only when you intentionally want scale/restart/delete/apply actions enabled.
DASHBOARD_WRITE_ENABLED=false

# Optional: point kubectl at a specific kubeconfig file.
# KUBECONFIG=/Users/you/.kube/config

# Protect apply requests from very large manifests.
MAX_MANIFEST_BYTES=524288
